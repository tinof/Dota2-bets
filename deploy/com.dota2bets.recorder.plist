<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Odds recorder as a user LaunchAgent, so line history keeps accruing across terminal
  closes, logouts and crashes. Install with:

      cp deploy/com.dota2bets.recorder.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dota2bets.recorder.plist

  Stop with:
      launchctl bootout gui/$(id -u)/com.dota2bets.recorder

  Note: this does not stop the Mac from sleeping. For unattended capture with the lid
  closed, keep the machine on mains power and run `caffeinate -s` alongside, or disable
  sleep for the duration of the event.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dota2bets.recorder</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/konstantinosfotiou/.local/bin/uv</string>
        <string>run</string>
        <string>dota2bets</string>
        <string>record-odds</string>
        <string>--interval</string>
        <string>60</string>
        <string>--live-interval</string>
        <string>20</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/konstantinosfotiou/Documents/GitHub/Dota2-bets</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it dies; throttle so a hard failure doesn't spin. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/konstantinosfotiou/Documents/GitHub/Dota2-bets/data/recorder.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/konstantinosfotiou/Documents/GitHub/Dota2-bets/data/recorder.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/konstantinosfotiou/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
